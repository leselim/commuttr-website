# Commuttr Website Environment Configuration Example
# Copy this file to .env and fill in production endpoint URLs and security tokens.

# Google Apps Script Web App Endpoints
VITE_WAITLIST_ENDPOINT=https://script.google.com/macros/s/YOUR_WAITLIST_SCRIPT_ID/exec
VITE_CONTACT_ENDPOINT=https://script.google.com/macros/s/YOUR_CONTACT_SCRIPT_ID/exec

# Security Authorization Token (matches SCRIPT_PROPERTIES in Google Apps Script)
VITE_API_SECRET_TOKEN=YOUR_SECURITY_SECRET_TOKEN
